<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Non-secret configuration, resolved from build settings so a build can be
	pointed at a local Keycloak or backend without editing source. Left empty
	they fall back to the production defaults in EchnoConfiguration.

	Only these keys live here. Everything else is still generated by
	GENERATE_INFOPLIST_FILE and merged in — Xcode's INFOPLIST_KEY_* settings
	inject Apple's known keys only, and drop custom ones without a word, which
	is why this file exists.

	It sits outside echno-ios/ because that folder is a file-system
	synchronized group: anything inside it is added to Copy Bundle Resources
	automatically, and a target's own Info.plist being copied as a resource is
	a "Multiple commands produce" build failure.
	-->
	<key>ECHNO_API_BASE_URL</key>
	<string>$(ECHNO_API_BASE_URL)</string>
	<key>ECHNO_KEYCLOAK_ISSUER</key>
	<string>$(ECHNO_KEYCLOAK_ISSUER)</string>
	<key>ECHNO_KEYCLOAK_CLIENT_ID</key>
	<string>$(ECHNO_KEYCLOAK_CLIENT_ID)</string>
	<key>ECHNO_OAUTH_REDIRECT_URI</key>
	<string>$(ECHNO_OAUTH_REDIRECT_URI)</string>
</dict>
</plist>

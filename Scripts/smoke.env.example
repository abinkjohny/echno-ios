# Copy to .env.smoke (gitignored) and fill in ONE credential.
#
# Preferred: an offline_access refresh token from a signed-in session. It lasts,
# and using it exercises the real refresh path on the way in.
ECHNO_SMOKE_REFRESH_TOKEN=

# Or a bearer token, which expires in minutes.
#ECHNO_SMOKE_ACCESS_TOKEN=

# Or a direct grant against a SEPARATE test client. Never echno-ios-client:
# direct access grants are disabled on it deliberately.
#ECHNO_SMOKE_CLIENT_ID=echno-smoke-client
#ECHNO_SMOKE_CLIENT_SECRET=
#ECHNO_SMOKE_USERNAME=
#ECHNO_SMOKE_PASSWORD=

# Optional overrides.
#ECHNO_SMOKE_API_ORIGIN=https://backend.echno.in
#ECHNO_SMOKE_ISSUER=https://auth.echno.in/realms/echno-realm
#ECHNO_SMOKE_ORGANIZATION_ID=
